# Plantilla para .env.prod.local — el archivo con los secretos REALES de producción.
#
# Este archivo de ejemplo sí se commitea (no tiene secretos reales, son placeholders y
# valores recién generados sin usar en ningún lado todavía). El flujo es:
#
#   1. cp .env.prod.local.example .env.prod.local
#   2. Completar los placeholders con los valores reales de producción
#      (los APP_SECRET/OAUTH_*/JWT_PASSPHRASE de acá abajo ya son aleatorios nuevos,
#      podés dejarlos tal cual — son de un solo uso, nunca estuvieron en git).
#   3. Copiar .env.prod.local al servidor a mano (scp/rsync, nunca por git) —
#      NUNCA hacer "git add" de este archivo.
#   4. En el servidor: composer dump-env prod
#      (esto compila .env + .env.prod + .env.prod.local en .env.local.php,
#      que es lo que Symfony lee en producción — más rápido, sin volver a
#      parsear .env en cada request).

APP_SECRET=9edc58438985c8a70d55fa86f7b3927d

# Credenciales reales del Postgres de producción (usuario/contraseña/host propios,
# nunca reutilizar los de desarrollo).
DATABASE_URL="postgresql://usuario_prod:CONTRASEÑA_REAL@host-real:5432/saldo_banca?serverVersion=16&charset=utf8"

OAUTH_PASSPHRASE=3d4fe7d825afd52167a2a043929163a7
OAUTH_ENCRYPTION_KEY=2143815abbeca0a93f1f6b2cd9d9561b

JWT_PASSPHRASE=d36a039ba92b8b84b1090fec10e32eef71ae70a884c7f30c0ee2371d697022de

# Claves reales de cada proveedor externo (generar nuevas, no reusar las de dev)
APIKEY_TOQUE=completar-con-key-real-de-toque
APIKEY_FIXER=completar-con-key-real-de-fixer
APIKEY_EXCHANGERATE=completar-con-key-real-de-exchangerate

OPENWA_APIKEY=completar-con-key-real-de-openwa
OPENWA_SESSIONS=completar-con-session-id-real-de-openwa
