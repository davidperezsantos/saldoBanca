# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration
#
# --- Cómo están organizados los .env de este proyecto ---
# .env              este archivo — placeholders/valores seguros, se commitea.
# .env.dev          override de APP_SECRET solo para dev, se commitea (bajo riesgo, no sirve en prod).
# .env.local        valores reales de ESTA máquina de desarrollo — nunca se commitea (ya en .gitignore).
# .env.prod         defaults de producción SIN secretos (APP_ENV=prod, APP_DEBUG=0) — se commitea.
# .env.prod.local   secretos reales de producción — NUNCA se commitea (ya cubierto por /.env.*.local).
#                   Se arma a partir de .env.prod.local.example, se copia a mano al servidor
#                   (nunca por git), y ahí se corre "composer dump-env prod".

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ChangeMe
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> app/saldo ###
# API Key para integración con sistemas externos
API_KEY_SISTEMA_EXTERNO=your-api-key-here
# Clave de encriptación para datos sensibles
ENCRYPTION_KEY=your-encryption-key-32-chars-long!!
# Moneda base del sistema (todas las cuentas se almacenan en esta moneda)
CURRENCY=EUR
CURRENCY_SECUNDARY=CUP
###< app/saldo ###

# Taxes aplicar en las facturas cuando realizo las conciliaciones en %
TAXES=1

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/framework-bundle (trusted proxies) ###
# "REMOTE_ADDR" confía en quien sea que hable directo con PHP (el caso típico: nginx delante de
# PHP-FPM en la misma máquina). Si el reverse proxy real está en otra IP fija, poner esa IP/rango
# acá en vez de REMOTE_ADDR — ver framework.yaml.
TRUSTED_PROXIES=REMOTE_ADDR
###< symfony/framework-bundle (trusted proxies) ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
DATABASE_URL="postgresql://app:ChangeMe@127.0.0.1:5432/saldo_banca?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> league/oauth2-server-bundle ###
OAUTH_PRIVATE_KEY=%kernel.project_dir%/config/oauth/private.key
OAUTH_PUBLIC_KEY=%kernel.project_dir%/config/oauth/public.key
OAUTH_PASSPHRASE=ChangeMe
OAUTH_ENCRYPTION_KEY=ChangeMe
###< league/oauth2-server-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=ChangeMe
###< lexik/jwt-authentication-bundle ###


###> API-TOQUE ###
URL_TOQUE=https://tasas.eltoque.com/v1/trmi
APIKEY_TOQUE=your-toque-api-key-here
###> END API-TOQUE ###

###> API-FIXER ###
URL_FIXER=https://data.fixer.io/api/latest
APIKEY_FIXER=your-fixer-api-key-here
SYMBOLS_FIXER=EUR,USD,CUP,MXN,GBP,JPY,CAD,AUD,CHF
BASE_FIXER=['EUR','USD','CUP','MXN','GBP','JPY','CAD','AUD','CHF']
###> END API-FIXER ###

###> API-EXCHANGERATE ###
URL_EXCHANGERATE=https://v6.exchangerate-api.com/v6/
APIKEY_EXCHANGERATE=your-exchangerate-api-key-here
BASE_EXCHANGERATE=EUR
###> END API-EXCHANGERATE ###

###> OPEN-WA NOTIFICATION ###
OPENWA_ENABLED=true
OPENWA_URL=https://wa.skydalsolutions.com/api/
OPENWA_APIKEY=your-openwa-api-key-here
OPENWA_SESSIONS=your-openwa-session-id-here
###> END OPEN-WA NOTIFICATION ###






###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
