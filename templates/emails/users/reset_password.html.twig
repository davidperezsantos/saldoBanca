<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ 'email.reset.title'|trans }}</title>
		<style>
			body {
				font-family: Arial, sans-serif;
				line-height: 1.6;
				color: #333;
				max-width: 600px;
				margin: 0 auto;
				padding: 20px;
			}
			.container {
				background-color: #f4f4f4;
				border-radius: 8px;
				padding: 30px;
			}
			.header {
				background-color: #4F46E5;
				color: white;
				padding: 20px;
				border-radius: 8px 8px 0 0;
				text-align: center;
			}
			.content {
				background-color: white;
				padding: 30px;
				border-radius: 0 0 8px 8px;
			}
			.button {
				display: inline-block;
				padding: 12px 20px;
				margin: 20px 0;
				background-color: #4F46E5;
				color: white;
				text-decoration: none;
				border-radius: 6px;
				font-weight: bold;
			}
			.warning {
				background-color: #FEF3C7;
				border-left: 4px solid #F59E0B;
				padding: 15px;
				margin: 20px 0;
				border-radius: 4px;
			}
			.footer {
				text-align: center;
				margin-top: 30px;
				padding-top: 20px;
				border-top: 1px solid #e5e7eb;
				color: #6b7280;
				font-size: 14px;
			}
			.link {
				word-break: break-all;
				color: #4F46E5;
			}
		</style>
	</head>
	<body>
		<div class="container">
			<div class="header">
				<h1>{{ 'email.reset.header'|trans }}</h1>
			</div>
			<div class="content">
				<p>{{ 'email.reset.greeting'|trans({'%name%': name}) }}</p>

				<p>{{ 'email.reset.request_message'|trans }}</p>

				<p>{{ 'email.reset.instructions'|trans }}</p>

				<a href="{{ resetUrl }}" class="button">
					{{ 'email.reset.button'|trans }}
				</a>

				<p>{{ 'email.reset.alternative'|trans }}</p>
				<p class="link">{{ resetUrl }}</p>

				<div class="warning">
					<strong>{{ 'email.reset.warning_title'|trans }}</strong>
				<p>{{ 'email.reset.warning_message'|trans({'%hours%': expirationHours}) }}</p>
				</div>

				<p>{{ 'email.reset.ignore'|trans }}</p>
			</div>

			<div class="footer">
				<p>{{ 'email.reset.footer'|trans }}</p>
			</div>
		</div>
	</body>
</html>
