{% extends 'admin_layout.html.twig' %}

{% block title %}{{ user is defined and user ? 'Editar' : 'Crear' }} Usuario - SaldoGrin{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">{{ user is defined and user ? 'Editar' : 'Crear' }} Usuario</h1>
        <a href="{{ path('admin_users_page') }}" class="text-gray-500 hover:text-gray-700 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Volver
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        {% if user is defined and user and user.username %}
        <div class="mb-6">
            <label class="block text-sm font-medium text-gray-500 mb-2">Username</label>
            <div class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-gray-700 font-mono">
                {{ user.username }}
            </div>
            <p class="mt-1 text-xs text-gray-400">Generado automáticamente. Se usa para iniciar sesión.</p>
        </div>
        {% endif %}

        <div class="grid grid-cols-2 gap-6 mb-6">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Email *</label>
                <input type="email" id="user-email" required
                       value="{{ user is defined and user ? user.email : '' }}"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
                       placeholder="usuario@email.com">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Nombre *</label>
                <input type="text" id="user-name" required
                       value="{{ user is defined and user ? user.name|default('') : '' }}"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
                       placeholder="Nombre completo">
            </div>
        </div>

        <div class="grid grid-cols-2 gap-6 mb-6">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Contraseña {{ user is defined and user ? '(dejar vacío para no cambiar)' : '*' }}
                </label>
                <input type="password" id="user-password"
                       {{ user is defined and user ? '' : 'required' }}
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
                       placeholder="••••••••">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Rol</label>
                <select id="user-role" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
                    <option value="">Sin rol</option>
                    {% for role in roles %}
                    <option value="{{ role.id.toRfc4122() }}"
                        {{ user is defined and user and user.role and user.role.id == role.id ? 'selected' : '' }}>
                        {{ role.label }}
                    </option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="mb-6">
            <label class="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" id="user-active"
                       {{ user is not defined or (user is defined and user and user.isActive) ? 'checked' : '' }}
                       class="h-4 w-4 text-emerald-600 focus:ring-emerald-500 border-gray-300 rounded">
                <span class="text-sm font-medium text-gray-700">Usuario activo</span>
            </label>
        </div>

        <div class="flex justify-end gap-3 pt-6 border-t border-gray-200">
            <a href="{{ path('admin_users_page') }}" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                Cancelar
            </a>
            <button type="button" onclick="saveUser()" class="px-6 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Guardar
            </button>
        </div>
    </div>
</div>

<script>
const userId = '{{ user is defined and user ? user.id.toRfc4122() : '' }}';

async function saveUser() {
    const email = document.getElementById('user-email').value.trim();
    const name = document.getElementById('user-name').value.trim();
    const password = document.getElementById('user-password').value;
    const roleId = document.getElementById('user-role').value;
    const isActive = document.getElementById('user-active').checked;

    if (!email) {
        alert('El email es requerido');
        return;
    }

    if (!userId && !password) {
        alert('La contraseña es requerida para nuevos usuarios');
        return;
    }

    const body = { email, name, role_id: roleId || null, is_active: isActive };
    if (password) body.password = password;

    const url = userId ? `/admin/users/${userId}/update` : '/admin/users/store';

    try {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });

        const data = await response.json();

        if (data.success) {
            window.location.href = '{{ path("admin_users_page") }}';
        } else {
            alert('Error: ' + (data.error || 'Error desconocido'));
        }
    } catch (error) {
        alert('Error al guardar: ' + error.message);
    }
}
</script>
{% endblock %}
