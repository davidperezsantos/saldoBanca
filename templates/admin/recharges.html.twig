    data-currencies-list-url="{{ path('admin_currency_list') }}"
    data-list-url="{{ path('admin_recharge_index') }}"
    data-convert-url="{{ path('admin_recharge_convert') }}"
    data-create-url="{{ path('admin_recharge_create') }}"
    data-complete-url="{{ path('admin_recharge_complete', {id: '__ID__'}) }}"
