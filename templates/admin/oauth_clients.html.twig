{% extends 'admin_layout.html.twig' %}

{% block title %}Clientes OAuth2 - Saldo Banca{% endblock %}

{% block body %}
<div id="vue-app"
    data-list-url="{{ path('admin_oauth_client_index') }}"
    data-create-url="{{ path('admin_oauth_client_create') }}"
    data-detail-url="{{ path('admin_oauth_client_update', {identifier: '__ID__'}) }}"
