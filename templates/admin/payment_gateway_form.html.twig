{% extends 'admin_layout.html.twig' %}

{% block title %}{{ gateway is defined and gateway ? 'Editar' : 'Crear' }} Pasarela de Pago - Saldo Banca{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">{{ gateway is defined and gateway ? 'Editar' : 'Crear' }} Pasarela de Pago</h1>
        <a href="{{ path('admin_payment_gateways_page') }}" class="text-gray-500 hover:text-gray-700">
            ← Volver
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <form id="gateway-form" class="space-y-6">
            <div class="grid grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nombre *</label>
                    <input type="text" name="name" required
                           value="{{ gateway is defined and gateway ? gateway.name : '' }}"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="Ej: Stripe, PayPal">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Código *</label>
                    <input type="text" name="code" required
                           value="{{ gateway is defined and gateway ? gateway.code : '' }}"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono"
                           placeholder="Ej: stripe, paypal">
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Tipo de Autenticación *</label>
                <select name="authType" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    <option value="">Selecciona una opción</option>
                    <option value="token" {{ gateway is defined and gateway and gateway.authType == 'token' ? 'selected' : '' }}>Token</option>
                    <option value="api_key" {{ gateway is defined and gateway and gateway.authType == 'api_key' ? 'selected' : '' }}>API Key</option>
                    <option value="user_pass" {{ gateway is defined and gateway and gateway.authType == 'user_pass' ? 'selected' : '' }}>Usuario y Contraseña</option>
                </select>
            </div>

            <div id="config-fields" class="space-y-4">
                <div id="token-field" class="hidden">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Token</label>
                    <input type="password" name="config[token]"
                           value="{{ gateway is defined and gateway and gateway.config ? gateway.config.token|default('') : '' }}"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono"
                           placeholder="Tu token de acceso">
                </div>
                <div id="api-key-field" class="hidden">
                    <label class="block text-sm font-medium text-gray-700 mb-2">API Key</label>
                    <input type="password" name="config[api_key]"
                           value="{{ gateway is defined and gateway and gateway.config ? gateway.config.api_key|default('') : '' }}"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono"
                           placeholder="Tu API Key">
                </div>
                <div id="user-pass-fields" class="hidden">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Usuario</label>
                            <input type="text" name="config[username]"
                                   value="{{ gateway is defined and gateway and gateway.config ? gateway.config.username|default('') : '' }}"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="Usuario">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Contraseña</label>
                            <input type="password" name="config[password]"
                                   value="{{ gateway is defined and gateway and gateway.config ? gateway.config.password|default('') : '' }}"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="Contraseña">
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Estado</label>
                    <select name="status" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        <option value="active" {{ gateway is defined and gateway and gateway.status == 'active' ? 'selected' : '' }}>Activo</option>
                        <option value="inactive" {{ gateway is defined and gateway and gateway.status == 'inactive' ? 'selected' : '' }}>Inactivo</option>
                    </select>
                </div>
                <div class="flex items-center">
                    <input type="checkbox" name="isDefault" id="isDefault"
                           {{ gateway is defined and gateway and gateway.isDefault ? 'checked' : '' }}
                           class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                    <label for="isDefault" class="ml-2 text-sm text-gray-700">Por defecto</label>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Notas</label>
                <textarea name="notes" rows="3"
                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                          placeholder="Notas adicionales sobre esta pasarela">{{ gateway is defined and gateway ? gateway.notes|default('') : '' }}</textarea>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t">
                <a href="{{ path('admin_payment_gateways_page') }}" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                    Cancelar
                </a>
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                    Guardar
                </button>
            </div>
        </form>
    </div>
</div>

<script>
document.querySelector('select[name="authType"]').addEventListener('change', function() {
    document.getElementById('token-field').classList.add('hidden');
    document.getElementById('api-key-field').classList.add('hidden');
    document.getElementById('user-pass-fields').classList.add('hidden');

    if (this.value === 'token') {
        document.getElementById('token-field').classList.remove('hidden');
    } else if (this.value === 'api_key') {
        document.getElementById('api-key-field').classList.remove('hidden');
    } else if (this.value === 'user_pass') {
        document.getElementById('user-pass-fields').classList.remove('hidden');
    }
});

document.querySelector('select[name="authType"]').dispatchEvent(new Event('change'));
</script>
{% endblock %}
